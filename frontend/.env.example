# Copy this file to .env.local (or .env.<mode>) for a local override, then restart
# the dev server. Vite statically inlines every import.meta.env.* value into the
# client bundle, so this template MUST contain only non-secret defaults — never
# place API keys, tokens, credentials, or secrets here. Secret handling belongs to
# the backend (env vars or a secrets manager), never the frontend bundle.

# API origin consumed by src/services/api/client.ts via import.meta.env.
# Default uses the same-origin relative path /v1 so production behind nginx works
# without modification (kept in sync with the versioned REST contract, spec 7.2).
# For local dev with the proxy disabled, set an ABSOLUTE URL with a protocol and
# host and NO trailing slash, e.g. http://localhost:8000/v1. A missing protocol or
# trailing slash causes an unrecoverable fetch failure (broken screen) — the API
# layer must then surface a retryable network-error state, never a silent blank.
VITE_API_BASE_URL=/v1

# Session inactivity timeout in MILLISECONDS, consumed by
# src/hooks/useSessionTimeout.ts via import.meta.env. 1800000 ms = 30 minutes,
# matching the spec inactivity policy (5.1 / 7.1 / 8.1) and enforced server-side.
# This is the ceiling: the hook must fire an aria-live countdown warning with a
# "Continue session" affordance some lead time BEFORE this value elapses; on
# expiry the app returns to login with a clear message.
VITE_SESSION_TIMEOUT_MS=1800000